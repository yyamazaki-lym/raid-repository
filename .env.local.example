# Supabase — required
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Discord auto-import — optional
# Only needed if you want the daily Discord cron pipeline.
# Bot setup: https://discord.com/developers/applications
# Required Privileged Gateway Intent: MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=

# Vercel Cron auth — optional
# Any sufficiently long random string. Vercel attaches this as
# `Authorization: Bearer ${CRON_SECRET}` to scheduled cron invocations.
CRON_SECRET=

# YouTube Data API v3 key — optional but recommended
# Required to fetch metadata (duration, upload date) for **限定公開
# (unlisted)** videos — common for raid groups uploading clear footage
# that's only shared with their static. Without this key, only public
# videos can be processed.
#
# How to get one (5分):
#   1. https://console.cloud.google.com → New Project
#   2. APIs & Services → Library → "YouTube Data API v3" → Enable
#   3. APIs & Services → Credentials → Create Credentials → API key
#   4. (Recommended) Restrict the key to "YouTube Data API v3" only
#
# Free tier: 10,000 quota units/day, 1 unit per video lookup.
YOUTUBE_API_KEY=
