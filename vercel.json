{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/import-discord",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/snapshot-schedule",
      "schedule": "50 12 * * *"
    },
    {
      "path": "/api/cron/fflogs-sync",
      "schedule": "0 19 * * *"
    }
  ]
}
