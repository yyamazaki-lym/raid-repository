# Supabase — required
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key — required (for Discord member gating)
# Settings → API → "service_role" key. NEVER expose to the browser.
# Used only server-side in /auth/callback to write `app_metadata`
# (`discord_guild_member`, `discord_roles`) on the auth.users row.
SUPABASE_SERVICE_ROLE_KEY=

# Discord — required for auth gate + auto-import
# Bot setup: https://discord.com/developers/applications (詳細は README Step 3 参照)
#   - Privileged Gateway Intents: SERVER MEMBERS INTENT (auth gate)
#                                  + MESSAGE CONTENT INTENT (auto-import)
#   - Bot must be a member of the guild specified in DISCORD_GUILD_ID
#     and have permission to view members.
DISCORD_BOT_TOKEN=

# Discord guild ID — required for auth gate
# Right-click the server icon in Discord (with Developer Mode ON)
# → "Copy Server ID". Membership of this guild is what gates the site.
DISCORD_GUILD_ID=

# Discord admin role IDs — optional (TODO #21)
# Comma-separated Discord role IDs. Members with at least one of these
# roles can create/update/delete categories (and trigger maintenance
# actions like Discord import / FFLogs sync).
#
# When unset/empty, ALL guild members can edit (backward-compatible
# default — preserves existing behavior for deployments that don't
# need admin gating).
#
# How to get role IDs: Discord Server Settings → Roles → right-click
# a role → "Copy Role ID" (Developer Mode must be ON).
#
# Example: DISCORD_ADMIN_ROLE_IDS=918765432109876543,918765432109876544
DISCORD_ADMIN_ROLE_IDS=

# --- Discord OAuth setup (dashboard only — see README Step 3, 4, 7) ---
# 1. Discord Developer Portal → your application → OAuth2 → Redirects
#    add: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    (固定値。portal の Vercel ドメインを変えても Discord 側設定の変更は不要)
# 2. Supabase dashboard → Authentication → Providers → Discord
#    enable, paste Discord Client ID + Client Secret
# 3. Supabase dashboard → Authentication → URL Configuration
#    Site URL:        https://<YOUR_VERCEL_DOMAIN>
#    Redirect URLs:   https://<YOUR_VERCEL_DOMAIN>/auth/callback
#                     http://localhost:3000/auth/callback
#    (Vercel ドメイン変更時はここを更新。詳細手順は .claude/todos/20.md)
# 4. FFLogs OAuth app (https://www.fflogs.com/api/clients/) → Redirect URLs
#    https://<YOUR_VERCEL_DOMAIN>/api/auth/fflogs/callback
#    (Vercel ドメイン変更時は exact match のため必ず更新)

# Vercel Cron auth — optional
# Any sufficiently long random string. Vercel attaches this as
# `Authorization: Bearer ${CRON_SECRET}` to scheduled cron invocations.
CRON_SECRET=

# Schedule source URL — optional (build-time fallback)
# 通常は portal の設定ダイアログから保存し、Supabase の `app_settings`
# (key=`schedule_url`) で全メンバーに共有する運用なので **未設定で問題ない**。
# fork 時にビルド時点で URL を埋め込みたい場合のみここに記述すると、DB に
# `schedule_url` 行が無い時のフォールバックとして使われる。
# 形式: `https://character-sheets.appspot.com/schedule/list?key=...`
# NEXT_PUBLIC_SCHEDULE_URL=

# YouTube Data API v3 key — optional but strongly recommended
# Without this key, **限定公開 (unlisted)** 動画 — raid 固定がよく使う
# 「URL を知っている人だけ見られる」設定 — の duration/uploadDate が
# 取得できず、累計練習時間や初クリア日時の自動計算に欠落が出る。
# 公開動画は HTML scrape で取得できるが Vercel IP の bot 検出で失敗
# することもあり、API key 経由のほうが安定。
#
# 設定はサーバー側 1 回 (admin) のみ。動画をアップロードするメンバー
# 個別の設定は不要 (= API key は「我々のアプリが YouTube API を呼ぶ
# 鍵」、各動画の所有者ではないため)。
#
# How to get one (5分):
#   1. https://console.cloud.google.com → New Project
#   2. APIs & Services → Library → "YouTube Data API v3" → Enable
#   3. APIs & Services → Credentials → Create Credentials → API key
#   4. (Recommended) Restrict the key to "YouTube Data API v3" only
#
# Free tier: 10,000 quota units/day, 1 unit per video lookup.
# 制限: 完全 private 動画 (uploader しか見れない) は不可、unlisted
# (限定公開) と public は OK。
YOUTUBE_API_KEY=

# FFLogs API v1 key — optional
# Required to auto-match FFLogs reports to videos by date. Without
# this key, FFLogs URLs must be entered manually on each video.
#
# How to get one:
#   1. https://www.fflogs.com → log in with your FFLogs account
#   2. https://www.fflogs.com/api/clients/ → Create New Client
#   3. Copy the "Public Key"
#
# The setup also needs each固定's representative FFLogs username
# (string, not numeric ID) — set in the app's settings dialog
# under the Logs section once this env var is present.
FFLOGS_API_KEY=

# === FFLogs v2 OAuth (Authorization Code Flow) — optional ===
# v1 API key (上記) では取得できない **Private / Unlisted レポート**
# の取得に必要。一般的なメンバー視点で portal を回す分には v1 だけで
# 十分。FFLogs に「メンバー限定で残しているログ」を portal から自動
# マッチさせたい固定向け。
#
# How to get OAuth credentials:
#   1. https://www.fflogs.com → log in
#   2. https://www.fflogs.com/api/clients/ → Create New Client
#   3. **Public** ではなく Authorization Code 用の OAuth Client を作る
#   4. Redirect URLs に以下を **両方** 登録:
#        http://localhost:3000/api/auth/fflogs/callback
#        https://YOUR_VERCEL_DOMAIN/api/auth/fflogs/callback
#      (Vercel ドメイン変更時は必ず exact match で更新)
#   5. 表示された Client ID / Client Secret を以下に貼り付け
#
# 設定後、portal の設定ダイアログ → Logs セクション → "Connect FFLogs"
# でアプリ管理者 1 人が認可すると、access_token / refresh_token は
# `secrets` テーブル (AES-256-GCM 暗号化、要 SECRET_ENCRYPTION_KEY) に
# 保存される。expires_at が近付くと refresh_token で自動更新。
FFLOGS_OAUTH_CLIENT_ID=
FFLOGS_OAUTH_CLIENT_SECRET=

# === SECRET_ENCRYPTION_KEY (TODO #35, 2.1+) ===
# AES-256-GCM 暗号化鍵 (32 バイト = 64 文字 hex)。
# `secrets` テーブルに保存される FFLogs session cookie / OAuth tokens
# 等の暗号化に使用。鍵が変わると過去の暗号化値は復号できなくなるので
# 一度設定したら変更しない (鍵 rotation したい場合は別途設計が必要)。
#
# 鍵生成: `openssl rand -hex 32`
#
# 未設定の場合は新 secrets テーブルへの暗号化保存が無効になり、旧
# `app_settings` 平文保存にフォールバック (互換性のため)。env 設定後
# にもう一度 cookie / OAuth を設定すると自動で暗号化テーブルへ移行。
SECRET_ENCRYPTION_KEY=

# === Dev-only auth bypass — NEVER set in production ===
# ローカル開発で Discord OAuth gate を丸ごと飛ばすためのフラグ。
# `DEV_AUTH_BYPASS=true` + `NODE_ENV !== "production"` の両方が
# 揃ったときのみ proxy.ts と auth.ts が偽 admin ユーザーで短絡する。
# 本番ビルド (Vercel) では `NODE_ENV === "production"` で必ず無効化
# されるので、誤って Vercel の env に設定しても fail-safe (二重ガード)。
#
# 使い方:
#   - `DEV_AUTH_BYPASS=true` だけ立てる: 偽 admin として全画面アクセス可
#   - `DEV_AUTH_BYPASS_NON_ADMIN=true` も追加: 偽ユーザーは roles=[] で
#     non-admin 視点を試せる (DISCORD_ADMIN_ROLE_IDS が設定されている
#     ときに有効)。
#
# 本番デプロイで万一立てると Discord 制限を完全に外す事故になるので、
# Vercel Project Settings → Environment Variables には絶対に追加しない。
# DEV_AUTH_BYPASS=
# DEV_AUTH_BYPASS_NON_ADMIN=

# === PUBLIC_DEMO_MODE (TODO #8 part E, 2.1+) ===
# モックサイト用に portal を **本番環境で読み取り専用公開** する用途のフラグ。
# `PUBLIC_DEMO_MODE=true` を立てると proxy.ts と auth.ts の両方で Discord
# OAuth gate が skip され、誰でもログイン無しで全カテゴリを閲覧できる。
#
# 書き込み防御 (4 層):
#   1. proxy.ts: 通常 admin gate は Discord auth gate と独立で残る (が demo
#      mode では auth gate を skip するので 1 層目は無効化)
#   2. auth.ts: demo mode user は roles=[] = 非 admin で固定。書き込み系
#      Server Action の `requireAdmin()` / `assertAdminResult()` で全弾き
#   3. createClient(): service role に切替えない (dev bypass と違って
#      PUBLIC_DEMO_MODE では anon key で動作)
#   4. RLS: anon key + auth session 無し → write policy `WITH CHECK
#      (auth.jwt()->>is_admin = 'true')` を通過できず block
#
# 用途:
#   - TODO #8 のモックサイト (Vercel + Supabase 別インスタンスに demo seed
#     を入れて公開) で portal の使用感を見せる
#   - 実 fork の本番デプロイでは絶対に立てない (認証が外れる)
#
# DEV_AUTH_BYPASS との違い:
#   - DEV_AUTH_BYPASS は NODE_ENV !== "production" のみ有効 / admin 視点
#     も可
#   - PUBLIC_DEMO_MODE は production でも有効 / 必ず非 admin (read-only)
#
# 両方 true なら DEV_AUTH_BYPASS が優先される (= ローカル開発で admin 視点
# を維持したまま、Vercel preview には demo 設定をそのまま使える)。
# PUBLIC_DEMO_MODE=


# Cold start スプラッシュ SW (public/sw.js) のキルスイッチ — optional
# "true" のときだけ production ビルドで Service Worker を登録し、Vercel
# Node 関数の cold start 中 (実測 3〜4s) の白画面をスプラッシュ画面に
# 置き換える。それ以外の値 / 未設定では登録しない + 既登録 SW を
# unregister する (ブラウザへの粘着対策)。dev では常に無効。
# NEXT_PUBLIC_* はビルド時インライン化のため、切替には再デプロイが必要。
# NEXT_PUBLIC_SPLASH_SW=true
