# Supabase — required
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key — required (for Discord member gating)
# Settings → API → "service_role" key. NEVER expose to the browser.
# Used only server-side in /auth/callback to write `app_metadata`
# (`discord_guild_member`, `discord_roles`) on the auth.users row.
SUPABASE_SERVICE_ROLE_KEY=

# Discord — required for auth gate + auto-import
# Bot setup: https://discord.com/developers/applications
#   - Privileged Gateway Intents: SERVER MEMBERS INTENT (auth gate)
#                                  + MESSAGE CONTENT INTENT (auto-import)
#   - Bot must be a member of the guild specified in DISCORD_GUILD_ID
#     and have permission to view members.
DISCORD_BOT_TOKEN=

# Discord guild ID — required for auth gate
# Right-click the server icon in Discord (with Developer Mode ON)
# → "Copy Server ID". Membership of this guild is what gates the site.
DISCORD_GUILD_ID=

# Discord admin role IDs — optional (TODO #21)
# Comma-separated Discord role IDs. Members with at least one of these
# roles can create/update/delete categories (and trigger maintenance
# actions like Discord import / FFLogs sync).
#
# When unset/empty, ALL guild members can edit (backward-compatible
# default — preserves existing behavior for deployments that don't
# need admin gating).
#
# How to get role IDs: Discord Server Settings → Roles → right-click
# a role → "Copy Role ID" (Developer Mode must be ON).
#
# Example: DISCORD_ADMIN_ROLE_IDS=918765432109876543,918765432109876544
DISCORD_ADMIN_ROLE_IDS=

# --- Discord OAuth setup (one-time, dashboard only — no env vars below) ---
# 1. Discord Developer Portal → your application → OAuth2 → Redirects
#    add: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# 2. Supabase dashboard → Authentication → Providers → Discord
#    enable, paste Discord Client ID + Client Secret
# 3. Supabase dashboard → Authentication → URL Configuration
#    add to "Redirect URLs": https://your-vercel-domain/auth/callback
#                            http://localhost:3000/auth/callback

# Vercel Cron auth — optional
# Any sufficiently long random string. Vercel attaches this as
# `Authorization: Bearer ${CRON_SECRET}` to scheduled cron invocations.
CRON_SECRET=

# YouTube Data API v3 key — optional but strongly recommended
# Without this key, **限定公開 (unlisted)** 動画 — raid 固定がよく使う
# 「URL を知っている人だけ見られる」設定 — の duration/uploadDate が
# 取得できず、累計練習時間や初クリア日時の自動計算に欠落が出る。
# 公開動画は HTML scrape で取得できるが Vercel IP の bot 検出で失敗
# することもあり、API key 経由のほうが安定。
#
# 設定はサーバー側 1 回 (admin) のみ。動画をアップロードするメンバー
# 個別の設定は不要 (= API key は「我々のアプリが YouTube API を呼ぶ
# 鍵」、各動画の所有者ではないため)。
#
# How to get one (5分):
#   1. https://console.cloud.google.com → New Project
#   2. APIs & Services → Library → "YouTube Data API v3" → Enable
#   3. APIs & Services → Credentials → Create Credentials → API key
#   4. (Recommended) Restrict the key to "YouTube Data API v3" only
#
# Free tier: 10,000 quota units/day, 1 unit per video lookup.
# 制限: 完全 private 動画 (uploader しか見れない) は不可、unlisted
# (限定公開) と public は OK。
YOUTUBE_API_KEY=

# FFLogs API v1 key — optional
# Required to auto-match FFLogs reports to videos by date. Without
# this key, FFLogs URLs must be entered manually on each video.
#
# How to get one:
#   1. https://www.fflogs.com → log in with your FFLogs account
#   2. https://www.fflogs.com/api/clients/ → Create New Client
#   3. Copy the "Public Key"
#
# The setup also needs each固定's representative FFLogs username
# (string, not numeric ID) — set in the app's settings dialog
# under the Logs section once this env var is present.
FFLOGS_API_KEY=
